@{
    ViewBag.Title = "Добавление фитнес-центра";
}

<style>
    body {
        font-family: Arial, sans-serif;
        padding: 20px;
        background: #f0f0f0;
    }

    .container {
        background: white;
        padding: 20px;
        border-radius: 8px;
        max-width: 500px;
        margin: auto;
    }

    h2 {
        text-align: center;
        margin-bottom: 20px;
    }

    .form-group {
        margin-bottom: 15px;
    }

    label {
        display: block;
        font-weight: bold;
        margin-bottom: 5px;
    }

    input[type="text"], input[type="number"] {
        width: 100%;
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
        box-sizing: border-box;
    }

    .btn {
        display: block;
        width: 100%;
        padding: 10px;
        background: #28a745;
        color: white;
        border: none;
        border-radius: 4px;
        cursor: pointer;
        font-size: 16px;
    }

        .btn:hover {
            background: #218838;
        }
</style>

<div class="container">
    <h2>Добавление фитнес-центра</h2>

    @using (Html.BeginForm())
    {
        <div class="form-group">
            <label>ID (числовой, допускает null):</label>
            @Html.TextBox("id", null, new { type = "number", @class = "form-control" })
        </div>

        <div class="form-group">
            <label>Название фитнес-центра:</label>
            @Html.TextBox("name", null, new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label>Адрес:</label>
            @Html.TextBox("address", null, new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label>Телефон:</label>
            @Html.TextBox("phone", null, new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label>Время работы:</label>
            @Html.TextBox("workingHours", null, new { @class = "form-control" })
        </div>

        <div class="form-group">
            <label>Наличие бассейна:</label>
            @Html.CheckBox("hasPool", false)
            <span>Есть бассейн</span>
        </div>

        <button type="submit" class="btn">Добавить</button>
    }
</div>